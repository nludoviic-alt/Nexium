{
  "name": "nexium-email-service",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Service dédié à la boîte e-mail collaborative Nexium (IMAP/SMTP OVH, routing, assignation). Déployé indépendamment sur le VPS, séparé du site statique.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "sync:once": "tsx src/lib/imap.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "cors": "^2.8.5",
    "dompurify": "^3.2.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "imapflow": "^1.0.184",
    "jsdom": "^25.0.1",
    "mailparser": "^3.7.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/mailparser": "^3.4.5",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
