# Copier en .env (jamais committé — voir .gitignore) et remplir une fois la config OVH prête.

PORT=4100
DATABASE_URL=file:./data/email.db

# Secret partagé entre le frontend admin et cette API (barrière service-à-service, PAS
# une authentification utilisateur). Générer avec: openssl rand -hex 32
API_SHARED_SECRET=change-me-generate-a-real-random-secret

# Origine autorisée à appeler l'API (URL du dashboard admin en production).
CORS_ORIGIN=https://votre-domaine.com

# --- Boîte OVH partagée (§12) — à remplir plus tard ---
EMAIL_ADDRESS=contact@mondomaine.com
EMAIL_PASSWORD=

# Paramètres OVH MX Plan classiques (à confirmer selon votre offre exacte) :
IMAP_HOST=ssl0.ovh.net
IMAP_PORT=993
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465

# Nom affiché au destinataire : "Nexium Markets <contact@mondomaine.com>"
SENDER_DISPLAY_NAME=Nexium Markets

# Intervalle de synchro IMAP si vous utilisez la boucle interne plutôt qu'un cron externe.
SYNC_INTERVAL_SECONDS=60

ATTACHMENTS_DIR=./storage/attachments
MAX_ATTACHMENT_SIZE_MB=15
ALLOWED_ATTACHMENT_MIME_TYPES=application/pdf,image/png,image/jpeg,image/gif,image/webp,text/plain,text/csv,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
