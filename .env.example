# =====================================================================
# NEXIUM MARKETS - CONFIGURATION DES SERVICES CLOUD (.env.example)
# =====================================================================

# 1. BASE DE DONNÉES & AUTHENTIFICATION (SUPABASE)
# Obtenez vos identifiants sur https://supabase.com -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. ENVOI D'E-MAILS TRANSACTIONNELS (RESEND)
# La clé API Resend n'est PAS une variable VITE_ : elle ne doit jamais être
# exposée au client. Configurez-la comme secret de l'Edge Function Supabase
# `send-email` (voir supabase/functions/send-email/README.md), pas ici.
VITE_RESEND_FROM_EMAIL=Nexium Markets <onboarding@resend.dev>

# 3. MODULE E-MAILS ADMIN OVH (MICROSERVICE VPS)
VITE_EMAIL_API_URL=http://localhost:4100
VITE_EMAIL_API_KEY=
